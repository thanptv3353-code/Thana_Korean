# Read this file as configuration guidance; the app does not auto-load dotenv.
# Keep real values private and outside Git.
THANA_ENV=development
THANA_DEBUG=0
PORT=8035
# Set both storage paths for a durable deployment:
# THANA_DATA_DIR=/persistent/thana
# THANA_PLATFORM_DB=/persistent/thana/platform.sqlite3
# Fresh installations only; existing account passwords are preserved:
# THANA_BOOTSTRAP_PASSWORD=replace-with-a-private-12-or-more-character-password
# Optional Google OIDC (install requirements first):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://thanakorean.com/auth/google/callback
# Optional OpenAI Tutor, disabled until explicitly configured:
THANA_AI_ENABLED=0
# OPENAI_API_KEY=
# THANA_AI_MODEL=
# Optional Microsoft Azure speech, disabled until explicitly configured:
THANA_SPEECH_ENABLED=0
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_RESOURCE=

# Optional staff AI voice generation (independent from speech recognition):
THANA_TTS_ENABLED=0
# Uses AZURE_SPEECH_KEY above. Region must match the Speech resource.
# AZURE_SPEECH_REGION=southeastasia

# Optional separate staging access gate (use HTTPS):
THANA_STAGING_ENABLED=0
# THANA_STAGING_USER=reviewer
# THANA_STAGING_PASSWORD=private-random-value-at-least-16-characters
